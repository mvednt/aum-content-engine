# Copy to .env and fill in. Never commit .env.

# Required
TELEGRAM_BOT_TOKEN=your_token_here
GEMINI_API_KEY=your_key_here

# Required: the private capture channel the bot listens to.
# Negative number starting with -100, from @userinfobot.
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Optional: shared secret Telegram sends on every webhook call.
# Set it here and pass the same value as secret_token when you call setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Which model writes the draft: gemini or claude.
# The course stack drafts with Gemini in L3 and moves to Claude from B1.
DRAFT_MODEL=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DRAFT_MODEL=gemini-2.5-pro

# Notes scoring below this are rejected without a draft.
MIN_SCORE=6

# Optional memory layer. Leave blank to run without storage.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
